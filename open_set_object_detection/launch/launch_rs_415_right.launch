<?xml version="1.0"?>
<launch>
    <group ns="right">
        <include file="$(find realsense2_camera)/launch/rs_aligned_depth.launch">
            <arg name="camera" value="rs_415_right" />
            <arg name="serial_no" value="210622060509" />
            <arg name="color_width" value="1280" />
            <arg name="color_height" value="720" />
            <arg name="enable_pointcloud" value="true" />
        </include>
    </group>
    <include file="$(find open_set_object_detection)/launch/right_arm_rs_415_extrinsic.launch"/>
</launch>
